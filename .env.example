# NeuroSense Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# Environment mode: 'development' or 'production' (disables public Swagger docs and enforces HSTS)
NEUROSENSE_ENV=development

# Database location
DATABASE_PATH=data/database/neurosense.db

# CORS Allowed Origins (comma-separated list of frontends allowed to query the API)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Rate limiting for auth endpoints (/auth/login, /auth/register) in requests per minute
RATE_LIMIT_PER_MINUTE=20
